{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "vscode:*" },
        { "url": "vscode-insiders:*" }
      ]
    }
  ]
}
