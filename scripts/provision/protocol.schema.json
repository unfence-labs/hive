{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive.dev/schemas/provision-ndjson/v1",
  "title": "Hive provision NDJSON line",
  "description": "One JSON object per line, emitted on stdout and appended to /var/lib/hive/provision.log.ndjson. See docs/install-flow-implementation-plan.md 3.1.",
  "type": "object",
  "required": ["v", "seq", "ts"],
  "properties": {
    "v": { "const": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "ts": { "type": "string", "format": "date-time" },
    "event": { "enum": ["run_start", "run_end"] },
    "runId": { "type": "string" },
    "scriptVersion": { "type": "string" },
    "resume": { "type": "boolean" },
    "stepsPlanned": { "type": "array", "items": { "type": "string" } },
    "step": { "type": "string" },
    "status": { "enum": ["start", "log", "ok", "skip", "error"] },
    "title": { "type": "string" },
    "line": { "type": "string" },
    "reason": { "type": "string" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "exitCode": { "type": "integer" },
    "errorCode": { "type": "string" },
    "detail": { "type": "string" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "run_start" } }, "required": ["event"] },
      "then": { "required": ["runId", "scriptVersion", "stepsPlanned"] }
    },
    {
      "if": { "properties": { "event": { "const": "run_end" } }, "required": ["event"] },
      "then": { "required": ["status"], "properties": { "status": { "enum": ["ok", "error"] } } }
    },
    {
      "if": { "required": ["step"] },
      "then": { "required": ["status"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } }, "required": ["status", "step"] },
      "then": { "required": ["errorCode"] }
    }
  ]
}
